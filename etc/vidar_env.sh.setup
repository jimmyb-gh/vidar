#!/bin/sh
#
# vidar_env.sh.setup - vidar environment variables template.
#
#
# VIDAR_ENVIRONMENT and VIDAR_HOME are set by the vidar_install.sh
# script using template vidar_env.sh.setup.  See the function
# fix_runtime_environment() in the install script.
export VIDAR_ENVIRONMENT=@@@VIDAR_ENVIRONMENT_TAG@@@

# All other variables are derived from VIDAR_HOME
export VIDAR_HOME=@@@VIDAR_HOMEDIR@@@


export VIDAR_SEC=${VIDAR_HOME}/sec
export VIDAR_SCRIPTS=${VIDAR_HOME}/scripts
export VIDAR_UTILS=${VIDAR_HOME}/utils
export VIDAR_TESTDATA=${VIDAR_HOME}/testdata
export VIDAR_ETC=${VIDAR_HOME}/etc
export VIDAR_LIBEXEC=${VIDAR_HOME}/libexec
export VIDAR_POSTGRES=${VIDAR_HOME}/postgres

# Vidar output files
# export VIDAR_LOGS=/var/log/vidar
export VIDAR_LOGS=${VIDAR_HOME}/logs

# DEBUGGING
# SEC dump file location - used for debugging.
# See scripts/run_sec.sh for filename.
export VIDAR_DUMP=${VIDAR_LOGS}
export VIDAR_DEBUG=${VIDAR_LOGS}
#
# Change these to /dev/null if desired.
export VIDAR_SEC_STDERR=${VIDAR_LOGS}/sec_stderr.txt
export VIDAR_READSEC_STDERR=${VIDAR_LOGS}/readSEC_stderr.txt
export VIDAR_ADD2BAD_STDERR=${VIDAR_LOGS}/add2BAD_stderr.txt

# Vidar PIDS directory.  All pids go in this directory.
export VIDAR_PIDS=${VIDAR_HOME}/pids


# Use these file for testing.
# Run the utils/push.sh  script to test.
# Vidar input logs
export VIDAR_INPUT=${VIDAR_HOME}/input

#
# Vidar input files.
# These are INPUT logs, not OUTPUT logs.
#
# Running 'vidar_install.sh dev' initializes VIDAR_INPUT to
# test mode (${VIDAR_INPUT}/auth.log) 
# whereas running 'vidar_install prod' initializes VIDAR_INPUT
# to production mode (/var/log/....)

export AUTHLOG=${VIDAR_INPUT}/auth.log
export EMAILLOG=${VIDAR_INPUT}/maillog
export NGINXLOG=${VIDAR_INPUT}/access.log

export PSLOG=${VIDAR_INPUT}/ps.txt
export NET4LOG=${VIDAR_INPUT}/net4.txt
export NET6LOG=${VIDAR_INPUT}/net6.txt

# The script utils/switch_input.sh can switch the
# input sources from test to production.
# so we use the variable VIDAR_INPUT to tell us
# what is going on...
#
# See the above discussion on variable VIDAR_INPUT.
# This variable shows whether Vidar gets its input from
# production sources (/var/log/nginx/access, /var/log/maillog, etc.)
# or from test input in VIDAR_INPUT.
#
if [    $(dirname ${AUTHLOG})  = "/var/log"  \
     -a $(dirname ${EMAILLOG}) = "/var/log"  \
     -a $(dirname ${NGINXLOG}) = "/var/log/nginx" ]
then
     export VIDAR_TEST="OFF"
else
     export VIDAR_TEST="ON"
fi
 
show_row() {
    printf '%-47s %s\n' "$1" "$2"
}

# Print the environment only if explicitly asked to do so.
#
if [ "X${SHOW_ENV}" = "XY" ]
then 
  echo
  echo "VIDAR Environment: ${VIDAR_ENVIRONMENT} +++++ VIDAR TEST INPUT: ${VIDAR_TEST}"
  echo "---------------------------------------------------------------------------------"
  show_row "VIDAR_HOME=     [${VIDAR_HOME}]"
  show_row "VIDAR_HOME=     [${VIDAR_HOME}]"
  show_row "VIDAR_SEC=      [${VIDAR_SEC}]"
  show_row "VIDAR_SCRIPTS=  [${VIDAR_SCRIPTS}]"
  show_row "VIDAR_UTILS=    [${VIDAR_UTILS}]"
  show_row "VIDAR_POSTGRES= [${VIDAR_POSTGRES}]"
  show_row "VIDAR_PIDS=     [${VIDAR_PIDS}]"
  show_row "VIDAR_INPUT=    [${VIDAR_INPUT}]"
  show_row "VIDAR_TESTDATA= [${VIDAR_TESTDATA}]"
  show_row "VIDAR_ETC=      [${VIDAR_ETC}]"
  show_row "VIDAR_LIBEXEC=  [${VIDAR_LIBEXEC}]"
  show_row "DEBUGGING:" " "
  show_row "VIDAR_SEC_STDERR=     [${VIDAR_SEC_STDERR}]"
  show_row "VIDAR_READSEC_STDERR= [${VIDAR_READSEC_STDERR}]"
  show_row "VIDAR_ADD2BAD_STDERR= [${VIDAR_ADD2BAD_STDERR}]"

  show_row "INPUTS:" "OUTPUTS:"
  show_row "AUTHLOG=  [${AUTHLOG}]" "VIDAR_LOGS=[${VIDAR_LOGS}]"
  show_row "EMAILLOG= [${EMAILLOG}]" "SEC Dump (Debug) Location:"
  show_row "NGINXLOG= [${NGINXLOG}]"     "VIDAR_DUMP=[${VIDAR_DUMP}]"
  show_row "PSLOG   = [${PSLOG}]" " "
  show_row "NET4LOG = [${NET4LOG}]" " "
  show_row "NET6LOG = [${NET6LOG}]" " "
fi
 
